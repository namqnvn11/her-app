{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.her-pilates.com/api"
      },
      "channel": "production"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.her-pilates.com/api"
      },
      "channel": "preview"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6806189898"
      }
    }
  }
}
