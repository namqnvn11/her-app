{
  "expo": {
    "name": "HER - Pilates",
    "slug": "her-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F1"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.her.gymapp",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.her.gymapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4753a7e2-17f9-4aaa-b19f-5bc354a7a0d3"
      }
    },
    "owner": "namqnvn11",
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "HER cần truy cập thư viện ảnh để bạn chọn ảnh đại diện.",
          "cameraPermission": "HER cần dùng máy ảnh để bạn chụp ảnh đại diện."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4753a7e2-17f9-4aaa-b19f-5bc354a7a0d3",
      "fallbackToCacheTimeout": 4000,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
