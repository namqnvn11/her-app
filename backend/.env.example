# Sao chép file này thành ".env" rồi điền giá trị thật, KHÔNG commit file .env

# Chuỗi kết nối MongoDB.
# - Máy chủ AWS Lightsail (Mongo cài cùng máy — xem deploy/ và hướng dẫn deploy): mongodb://127.0.0.1:27017/her_gym
# - MongoDB Atlas (free tier M0): lấy trong Atlas > Connect > Drivers.
MONGODB_URI=mongodb://127.0.0.1:27017/her_gym

# Chuỗi bí mật để ký JWT — đặt một chuỗi ngẫu nhiên dài, giữ kín
JWT_SECRET=change_this_to_a_long_random_string

# Cổng chạy server
PORT=4000

# Số giờ tối thiểu trước giờ tập khách được tự hủy lịch — GIÁ TRỊ BAN ĐẦU.
# Từ 23/08/2026 admin chỉnh trực tiếp trong app (Cài đặt → Hủy lịch, lưu vào DB);
# đã lưu trong app rồi thì giá trị ở đây không còn tác dụng.
MIN_CANCEL_HOURS=3

# Thời hạn phiên đăng nhập (JWT). Mặc định 30 ngày.
# her-45: hạn này được GIA HẠN TRƯỢT — mỗi lần app mở (GET /me), token cũ hơn 1 ngày
# thì server cấp token mới, nên hạn tính từ lần MỞ APP gần nhất chứ không phải lần đăng nhập.
JWT_EXPIRES_IN=30d

# Cho phép tự đăng ký tài khoản qua POST /api/auth/register hay không.
# App hiện KHÔNG có màn hình đăng ký nên mặc định tắt; chỉ bật khi làm màn hình đăng ký.
ALLOW_SELF_REGISTER=false

# Chống đoán mật khẩu: chặn sau số lần đăng nhập sai, trong cửa sổ bao nhiêu phút
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Job nền chuyển buổi tập qua giờ thành "Đã tập" — chạy mỗi bao nhiêu phút
COMPLETE_SWEEP_MINUTES=5

# Múi giờ hiển thị nghiệp vụ (phút lệch so với UTC) — 420 = giờ Việt Nam (+7).
# Cần cho filter "Hôm nay" đúng khi deploy server ở host chạy UTC (Render...)
TZ_OFFSET_MINUTES=420

# Deploy máy chủ nước ngoài (UTC): PHẢI đặt múi giờ VN — lịch tự động lưu giờ theo đồng hồ server
TZ=Asia/Ho_Chi_Minh
